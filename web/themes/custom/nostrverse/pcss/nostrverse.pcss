@font-face {
  font-family: 'Ubuntu';
  src: url('../fonts/Ubuntu.woff2') format('woff2'),
  url('../fonts/Ubuntu.woff') format('woff'),
  url('../fonts/Ubuntu-R.ttf') format('truetype');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: 'Ubuntu Mono';
  src: url('../fonts/UbuntuMono-R.ttf') format('truetype');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}

@import "./theme.pcss";
@import "tailwindcss";
@source inline("badge");

h1, h2, h3, h4, h5, h6 {
  @apply font-ubuntu-mono font-bold;
}
div, p, ul, li, ol, small {
  @apply font-ubuntu;
}
header {
  @apply w-full font-ubuntu bg-neutral-100 drop-shadow-sm mb-4;
  .region-header {
    @apply px-0 py-0;
    .navbar {
      @apply bg-transparent shadow-none xl:w-3/4 lg:mx-auto;
    }
  }
  .site-logo {

  }
}
nav.breadcrumb {
  @apply mx-3 xl:mx-0 p-0;
  ol > li {
    @apply m-0;
    > a {
      @apply no-underline p-2;
    }
  }
}
body {
  &.page-node-type-page {
    article {
      p img {
        @apply max-w-1/2 md:max-w-full;
      }
    }
  }
  &.page-node-type-blog {
    article {
      p img {
        @apply lg:w-1/2 lg:mx-auto mb-4 max-w-full rounded-2xl shadow-md/25;
      }
    }
  }
}
main {
  @apply p-0;
  .layout-content {
    @apply mx-3 xl:mx-0;
    .block-page-title-block {
      @apply mt-4 mb-4 md:mb-8 mx-4 lg:mx-8;
    }
    article {
      @apply overflow-x-hidden bg-neutral-100 p-4 lg:p-8 rounded-4xl;
      div.node__content {
        .field_image img {
          @apply mx-auto rounded-sm;
        }
        a {
          @apply font-bold;
        }
        p img {
          @apply rounded-2xl shadow-md/25;
        }
        & > div {
          @apply wrap-break-word;
        }
      }
      .node__meta {
        @apply flex gap-x-2 justify-center items-center;
        img {
          @apply size-5 inline;
        }
      }
      p > a,
      li > a {
        @apply text-black underline-offset-1 decoration-1;
      }
    }
  }
}

a {
  @apply text-fuchsia-700 underline underline-offset-3 decoration-fuchsia-600/50 decoration-2 transition hover:text-fuchsia-900 hover:bg-fuchsia-600/20 active:text-fuchsia-800 focus:text-fuchsia-800;
}
.alert {
  &.alert-error {
    @apply rounded-none border border-red-700 bg-red-700/10 text-red-700;
    svg {
      @apply stroke-red-700;
    }
  }
}

article.node.node--view-mode-blog-teaser {
  h2 {
    @apply mb-2;
  }
  .node__content {
    @apply mt-2;
  }
}
.badge {
  > a {
    @apply no-underline;
  }
}

.region-breadcrumb,
.region-highlighted {
  @apply p-0;
}

footer {
  @apply w-full;
  .region-footer {
    @apply w-full;
  }
}

#block-nostrverse-views-block-blog-block-1 {
  h2 {
    @apply text-3xl mt-4;
  }
  .swiper-slide {
    article {
      h2 {
        @apply text-lg;
      }
      p {
        @apply text-sm truncate;
      }
      footer {
        @apply hidden;
      }
    }
  }
}
