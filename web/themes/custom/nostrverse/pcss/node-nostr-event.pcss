@import "tailwindcss" source('../../../contrib/tailwind_css');
.page-node-type-nostr-event {
  h1.page-title {
      @apply text-wrap wrap-anywhere mb-4;
  }
  .avatar {
    > a {
      @apply inline-block p-2 hover:bg-transparent;
      > img {
        @apply aspect-square rounded-full ring-fuchsia-200 ring-3 ring-offset-2 transition hover:ring-fuchsia-700 hover:ring-4;
      }
    }
  }
  .nostr-content {
    @apply m-0 p-4 text-xl bg-fuchsia-100 text-wrap wrap-anywhere;
    > img {
      @apply !w-full;
    }
  }
  .event_id {
    @apply font-mono;
  }
  .pubkey {
    @apply font-mono;
  }
  .signature {
    @apply font-mono;
  }
}
.modal-box {
  @apply w-11/12 !max-w-5xl;
}
